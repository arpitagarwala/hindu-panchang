# Server-only credentials. Never prefix with NEXT_PUBLIC_.
# cross-check: local result with independent status; verified-only: daily HTTP 503
# unless all checked daily fields match; local: no external provider calls.
PANCHANG_DATA_MODE=local
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
# Single-process UTC-day safety budget; shared/global limits need a shared store.
PANCHANG_REFERENCE_MAX_REQUESTS_PER_DAY=100

# Set the final canonical origin BEFORE building for public deployment.
# Preview installs stay noindex until explicitly enabled on a real HTTPS domain.
SITE_URL=
SITE_INDEXING=false
GOOGLE_SITE_VERIFICATION=
